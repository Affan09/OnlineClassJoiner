{
  "name": "iub-class-joiner",
  "version": "1.0.0",
  "description": "Automated Google Classroom & Google Meet Class Joiner for Independent University, Bangladesh (IUB)",
  "main": "dist-electron/electron/main.js",
  "author": "IUB Class Joiner Engineering",
  "license": "MIT",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.node.json && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "tsc -p tsconfig.json && vite build && tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -wl",
    "postinstall": "node -e \"if (!process.env.VERCEL && !process.env.NETLIFY) { try { require('child_process').execSync('playwright install chromium', { stdio: 'inherit' }); } catch(e){} }\""
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "playwright": "^1.48.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "edu.classroom.classjoiner",
    "productName": "Classroom Class Joiner (Alpha)",
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "synopsis": "Automated Google Classroom and Meet Joiner for IUB"
    }
  }
}